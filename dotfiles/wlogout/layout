{
    "label" : "lock",
    "action" : "dms ipc call lock lock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "hyprctl eval 'hl.dispatch(hl.dsp.exit())'",
    "text" : "Logout",
    "keybind" : "o"
}